# ===== LINE Developers > Messaging API channel =====
# 這兩個是機密，只能放在 .env（已被 .gitignore 排除），絕對不要 commit
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

PORT=3000
BOT_NAME=小幫手

# ===== Ollama（OpenAI 相容端點）=====
OLLAMA_BASE_URL=http://localhost:11434/v1
# 基底模型；執行 npm run setup:model 會建立一個 context 加大的變體給 bot 用
OLLAMA_BASE_MODEL=qwen3.5:4b
OLLAMA_MODEL=japan-trip-bot
# Ollama 預設 context 只有 4096，會截斷 system prompt
OLLAMA_NUM_CTX=16384
# AI 超過這個秒數沒回應就放棄（其他功能不受影響）
LLM_TIMEOUT_SECONDS=90

# ===== 拍照解說 =====
# OCR 服務（ocr/server.py）。留空 = 不用 OCR，改由視覺模型直接看圖（較慢、較不準）
OCR_URL=http://127.0.0.1:8001
# OCR 讀不到字時，是否改用視覺模型看圖；用不支援圖片的模型時請設成 false
VISION_ENABLED=true
MAX_IMAGE_MB=8
# 群組照片保留多久，讓大家可以「@小幫手 翻譯這張」
IMAGE_WINDOW_MINUTES=15

# ===== 其他 =====
DATA_DIR=data
# 匯率 API 連不上時使用
FALLBACK_JPY_TWD=0.21
MAX_CONTEXT_MESSAGES=30
# 回覆太慢導致 reply token 過期時，改用 push 補送（會用到每月免費推播額度）
ALLOW_PUSH_FALLBACK=false

# ===== Gemini 字典備援（選用）=====
# 照片上的日文詞彙在本機字典（手寫辭典 + Wikidata）查不到時，才問 Gemini，結果會存在本機，同一個詞只問一次。
# 只會送出「照片上讀到的日文片段」，不會送照片、聊天內容或成員名字。
# ⚠️ 免費方案的內容可能被 Google 用來改進產品並由人工審閱。留空 = 關閉。
# 申請：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=300

# ===== 聊天大腦 =====
# ollama（預設，全部在本機）或 gemini（聊天內容會傳給 Google；額度用完或斷線時自動改用本機 Ollama）
# 照片一律在本機處理，不會送給 Gemini
LLM_PROVIDER=ollama
GEMINI_CHAT_MODEL=gemini-3.5-flash
