# ===== LINE Developers > Messaging API channel =====
# 這兩個是機密，只能放在 .env（已被 .gitignore 排除），絕對不要 commit
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

PORT=3000
BOT_NAME=小幫手

# ===== Ollama（OpenAI 相容端點）=====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# ===== 拍照翻譯 =====
# 需要能看圖的模型；用不支援圖片的模型時請設成 false
VISION_ENABLED=true
MAX_IMAGE_MB=8
# 群組照片保留多久，讓大家可以「@小幫手 翻譯這張」
IMAGE_WINDOW_MINUTES=15

# ===== 其他 =====
DATA_DIR=data
# 匯率 API 連不上時使用
FALLBACK_JPY_TWD=0.21
MAX_CONTEXT_MESSAGES=30
# 回覆太慢導致 reply token 過期時，改用 push 補送（會用到每月免費推播額度）
ALLOW_PUSH_FALLBACK=false
